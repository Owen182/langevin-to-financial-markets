import math
import random

import matplotlib.pyplot as plt

m = 1.0
gamma = 1.0
kBT = 1.0

total_time = 10.0
total_steps = 1000
dt = total_time / total_steps

a = gamma / m
b = math.sqrt(2 * gamma * kBT) / m

x = 0.0
v = 0.0

times = [step * dt for step in range(total_steps + 1)]
positions = [x]
velocities = [v]

for step in range(total_steps):
    z = random.gauss(0, 1)

    x += v * dt
    v += -a * v * dt + b * math.sqrt(dt) * z

    positions.append(x)
    velocities.append(v)

fig, (ax_x, ax_v) = plt.subplots(2, 1, sharex=True)

ax_x.plot(times, positions)
ax_x.set_ylabel("Position x")

ax_v.plot(times, velocities)
ax_v.set_ylabel("Velocity v")
ax_v.set_xlabel("Time t")

plt.tight_layout()
plt.show()